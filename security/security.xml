<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Odoo 19: groups are organised by privilege -> category -->
    <record id="module_category_shop_management" model="ir.module.category">
        <field name="name">Shop Management</field>
        <field name="sequence">50</field>
    </record>

    <record id="privilege_shop_management" model="res.groups.privilege">
        <field name="name">Shop Management</field>
        <field name="category_id" ref="module_category_shop_management"/>
    </record>

    <record id="group_shop_cashier" model="res.groups">
        <field name="name">Cashier</field>
        <field name="privilege_id" ref="privilege_shop_management"/>
    </record>

    <record id="group_shop_inventory" model="res.groups">
        <field name="name">Inventory</field>
        <field name="privilege_id" ref="privilege_shop_management"/>
    </record>

    <!-- Manager sees everything; administrators get it automatically -->
    <record id="group_shop_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_shop_management"/>
        <field name="implied_ids" eval="[(4, ref('group_shop_cashier')), (4, ref('group_shop_inventory'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
