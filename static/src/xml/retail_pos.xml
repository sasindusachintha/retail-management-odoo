<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

    <t t-name="shop_management.RetailPOS">

        <div class="retail-pos">

            <!-- HEADER -->

            <header class="retail-header">

                <div class="header-branding">
                    <h1>Retail POS</h1>
                    <span>Shop Management</span>
                </div>

                <div class="search-area">

                    <div class="search-box">
                        <input
                            type="text"
                            placeholder="Search name, SKU, or barcode..."
                            t-model="state.search"
                            class="search-input"
                        />
                    </div>

                    <!-- Barcode scanner input -->
                    <div class="barcode-area">
                        <input
                            type="text"
                            placeholder="Scan barcode &amp; press Enter..."
                            t-model="state.barcodeInput"
                            t-on-keydown="onBarcodeKeydown"
                            class="barcode-input"
                        />
                        <button
                            class="barcode-btn"
                            t-on-click="searchByBarcode"
                            title="Scan / Search Barcode"
                        >
                            🔍 Scan
                        </button>
                    </div>

                    <!-- Barcode error message -->
                    <t t-if="state.barcodeError">
                        <div class="barcode-error">
                            <t t-esc="state.barcodeError"/>
                        </div>
                    </t>

                </div>

            </header>


            <!-- QUICK CUSTOMER MODAL -->

            <t t-if="state.showCustomerModal">
                <div class="pos-modal-overlay">
                    <div class="pos-modal">
                        <h3>Add New Customer</h3>
                        <div class="modal-field">
                            <label>Customer Name *</label>
                            <input type="text" t-model="state.newCustomerName" placeholder="John Doe" />
                        </div>
                        <div class="modal-field">
                            <label>Phone Number</label>
                            <input type="text" t-model="state.newCustomerPhone" placeholder="+123456789" />
                        </div>
                        <div class="modal-actions">
                            <button class="btn-cancel" t-on-click="closeCustomerModal">Cancel</button>
                            <button class="btn-save" t-on-click="createCustomer">Save Customer</button>
                        </div>
                    </div>
                </div>
            </t>


            <!-- COMPLETED SALE RECEIPT SCREEN -->

            <t t-if="state.completedOrder">

                <div class="sale-success">

                    <div class="success-icon">✓</div>

                    <h1>Sale Completed</h1>

                    <h2>
                        <t t-esc="state.completedOrder.name"/>
                    </h2>

                    <div class="receipt">

                        <div class="receipt-header-info">
                            <div class="receipt-title">RETAIL SHOP RECEIPT</div>
                            <div class="receipt-subtitle">Official Transaction Record</div>
                        </div>

                        <div class="receipt-line">
                            <span>Order Ref:</span>
                            <strong><t t-esc="state.completedOrder.name"/></strong>
                        </div>

                        <div class="receipt-line">
                            <span>Date:</span>
                            <span><t t-esc="state.completedOrder.order_date"/></span>
                        </div>

                        <div class="receipt-line">
                            <span>Cashier:</span>
                            <span><t t-esc="state.completedOrder.cashier_name"/></span>
                        </div>

                        <div class="receipt-line">
                            <span>Customer:</span>
                            <span><t t-esc="state.completedOrder.customer_name"/></span>
                        </div>

                        <hr class="receipt-divider"/>

                        <table class="receipt-table">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th>Qty</th>
                                    <th>Price</th>
                                    <th>Disc</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="state.completedOrder.lines" t-as="l" t-key="l.product_id">
                                    <tr>
                                        <td><t t-esc="l.product_name"/></td>
                                        <td><t t-esc="l.quantity"/></td>
                                        <td>Rs. <t t-esc="l.unit_price"/></td>
                                        <td>Rs. <t t-esc="l.discount"/></td>
                                        <td>Rs. <t t-esc="l.subtotal"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <hr class="receipt-divider"/>

                        <div class="receipt-line">
                            <span>Subtotal</span>
                            <strong>Rs. <t t-esc="state.completedOrder.subtotal"/></strong>
                        </div>

                        <div class="receipt-line">
                            <span>Order Discount</span>
                            <strong class="text-danger">- Rs. <t t-esc="state.completedOrder.discount"/></strong>
                        </div>

                        <div class="receipt-total">
                            <span>GRAND TOTAL</span>
                            <strong>Rs. <t t-esc="state.completedOrder.amount_total"/></strong>
                        </div>

                        <div class="receipt-line">
                            <span>Amount Paid</span>
                            <strong>Rs. <t t-esc="state.completedOrder.amount_paid"/></strong>
                        </div>

                        <div class="receipt-line">
                            <span>Change</span>
                            <strong>Rs. <t t-esc="state.completedOrder.change_amount"/></strong>
                        </div>

                        <div class="receipt-line">
                            <span>Payment Method</span>
                            <strong class="text-uppercase"><t t-esc="state.completedOrder.payment_method"/></strong>
                        </div>

                    </div>

                    <div class="success-actions">

                        <button
                            class="print-button"
                            t-on-click="printReceipt"
                        >
                            🖨️ Print Receipt
                        </button>

                        <button
                            class="new-sale-button"
                            t-on-click="newSale"
                        >
                            ➕ New Sale
                        </button>

                    </div>

                </div>

            </t>


            <!-- POS INTERFACE -->

            <t t-else="">

                <main class="retail-main">

                    <!-- PRODUCTS SECTION -->

                    <section class="products-section">

                        <div class="section-title">
                            <h2>Products</h2>
                            <span>
                                <t t-esc="filteredProducts.length"/> products available
                            </span>
                        </div>


                        <!-- CATEGORY FILTER -->

                        <div class="categories">

                            <button
                                t-att-class="state.category === 'all' ? 'category active' : 'category'"
                                t-on-click="() => state.category = 'all'"
                            >
                                All
                            </button>

                            <t
                                t-foreach="categoryList"
                                t-as="category"
                                t-key="category"
                            >

                                <button
                                    t-att-class="state.category === category ? 'category active' : 'category'"
                                    t-on-click="() => state.category = category"
                                >
                                    <t t-esc="category"/>
                                </button>

                            </t>

                        </div>


                        <!-- PRODUCT GRID -->

                        <div class="product-grid">

                            <t
                                t-foreach="filteredProducts"
                                t-as="product"
                                t-key="product.id"
                            >

                                <button
                                    t-att-class="product.quantity > 0 ? 'product-card' : 'product-card out-of-stock'"
                                    t-on-click="() => this.addProduct(product)"
                                >

                                    <div class="product-card-top">
                                        <t t-if="product.image">
                                            <img t-att-src="'data:image/png;base64,' + product.image" class="product-img" alt="Product Image"/>
                                        </t>
                                        <t t-else="">
                                            <div class="product-img-placeholder">📦</div>
                                        </t>
                                        <div class="product-card-meta">
                                            <div class="product-name">
                                                <t t-esc="product.name"/>
                                            </div>

                                            <div class="product-category">
                                                <t t-esc="product.category_id ? product.category_id[1] : 'General'"/>
                                            </div>

                                            <t t-if="product.sku || product.barcode">
                                                <div class="product-code-badge">
                                                    <t t-if="product.sku"><t t-esc="product.sku"/></t>
                                                    <t t-elif="product.barcode"><t t-esc="product.barcode"/></t>
                                                </div>
                                            </t>
                                        </div>
                                    </div>

                                    <div class="product-card-bottom">
                                        <div class="product-price">
                                            Rs. <t t-esc="product.price"/>
                                        </div>

                                        <div class="product-stock">
                                            <t t-if="product.quantity > 0">
                                                Stock: <strong><t t-esc="product.quantity"/></strong>
                                            </t>
                                            <t t-else="">
                                                <span class="stock-out">OUT OF STOCK</span>
                                            </t>
                                        </div>
                                    </div>

                                </button>

                            </t>

                        </div>

                    </section>


                    <!-- CART SECTION -->

                    <section class="cart-section">

                        <div class="section-title">
                            <h2>Current Sale</h2>
                            <span>
                                <t t-esc="state.cart.length"/> items in cart
                            </span>
                        </div>


                        <!-- CUSTOMER SELECT WITH QUICK ADD -->

                        <div class="field customer-field-group">
                            <label>Customer</label>
                            <div class="customer-input-container">
                                <select t-model="state.customer_id" class="customer-select">
                                    <option value="">Walk-in Customer (Anonymous)</option>
                                    <t
                                        t-foreach="state.customers"
                                        t-as="customer"
                                        t-key="customer.id"
                                    >
                                        <option t-att-value="customer.id">
                                            <t t-esc="customer.name"/>
                                            <t t-if="customer.phone"> (<t t-esc="customer.phone"/>)</t>
                                        </option>
                                    </t>
                                </select>
                                <button
                                    class="add-customer-btn"
                                    t-on-click="openCustomerModal"
                                    title="Add New Customer"
                                >
                                    + New
                                </button>
                            </div>
                        </div>


                        <!-- CART ITEMS -->

                        <div class="cart-items">

                            <t t-if="!state.cart.length">
                                <div class="empty-cart">
                                    <div class="empty-icon">🛒</div>
                                    <strong>Cart is empty</strong>
                                    <span>Scan a barcode or click products to add items</span>
                                </div>
                            </t>


                            <t
                                t-foreach="state.cart"
                                t-as="item"
                                t-key="item.product_id"
                            >

                                <div class="cart-item">

                                    <div class="cart-item-header">
                                        <strong class="item-name">
                                            <t t-esc="item.name"/>
                                        </strong>
                                        <button
                                            class="remove-button"
                                            t-on-click="() => this.removeItem(item)"
                                            title="Remove Item"
                                        >
                                            ×
                                        </button>
                                    </div>

                                    <div class="cart-item-controls">

                                        <div class="unit-price-label">
                                            @ Rs. <t t-esc="item.price"/>
                                        </div>

                                        <div class="quantity-controls">
                                            <button t-on-click="() => this.decrease(item)">−</button>
                                            <span class="qty-display"><t t-esc="item.quantity"/></span>
                                            <button t-on-click="() => this.increase(item)">+</button>
                                        </div>

                                        <div class="line-discount-box">
                                            <span>Disc:</span>
                                            <input
                                                type="number"
                                                min="0"
                                                t-att-value="item.discount || 0"
                                                t-on-change="(ev) => this.updateLineDiscount(item, ev.target.value)"
                                                class="line-discount-input"
                                            />
                                        </div>

                                        <div class="line-subtotal">
                                            Rs. <t t-esc="this.lineSubtotal(item)"/>
                                        </div>

                                    </div>

                                </div>

                            </t>

                        </div>


                        <!-- ORDER DISCOUNT -->

                        <div class="discount-field">
                            <label>Order Discount (Rs.)</label>
                            <input
                                type="number"
                                min="0"
                                t-model.number="state.discount"
                                placeholder="0.00"
                            />
                        </div>


                        <!-- TOTALS -->

                        <div class="cart-summary">

                            <div>
                                <span>Subtotal</span>
                                <strong>Rs. <t t-esc="subtotal"/></strong>
                            </div>

                            <div>
                                <span>Order Discount</span>
                                <strong class="discount-value">- Rs. <t t-esc="discount"/></strong>
                            </div>

                            <div class="total-row">
                                <span>Grand Total</span>
                                <strong class="grand-total-amount">Rs. <t t-esc="total"/></strong>
                            </div>

                        </div>


                        <!-- PAYMENT SECTION -->

                        <div class="payment-section">

                            <div class="payment-header">
                                <h3>Payment</h3>
                                <button
                                    class="split-payment-toggle"
                                    t-on-click="toggleMultiPayment"
                                >
                                    <t t-if="state.isMultiPayment">Single Payment</t>
                                    <t t-else="">Split Payment</t>
                                </button>
                            </div>


                            <t t-if="!state.isMultiPayment">

                                <div class="payment-methods">
                                    <button
                                        t-att-class="state.payment_method === 'cash' ? 'payment-method active' : 'payment-method'"
                                        t-on-click="() => state.payment_method = 'cash'"
                                    >
                                        💵 Cash
                                    </button>

                                    <button
                                        t-att-class="state.payment_method === 'card' ? 'payment-method active' : 'payment-method'"
                                        t-on-click="() => state.payment_method = 'card'"
                                    >
                                        💳 Card
                                    </button>

                                    <button
                                        t-att-class="state.payment_method === 'bank' ? 'payment-method active' : 'payment-method'"
                                        t-on-click="() => state.payment_method = 'bank'"
                                    >
                                        🏦 Bank
                                    </button>
                                </div>

                                <label>Amount Received</label>
                                <input
                                    class="amount-input"
                                    type="number"
                                    min="0"
                                    t-model.number="state.amount_paid"
                                    placeholder="0.00"
                                />

                            </t>


                            <t t-else="">

                                <div class="multi-payment-inputs">

                                    <div class="multi-pay-row">
                                        <span>💵 Cash Amount</span>
                                        <input
                                            type="number"
                                            min="0"
                                            t-model.number="state.multiPayments.cash"
                                        />
                                    </div>

                                    <div class="multi-pay-row">
                                        <span>💳 Card Amount</span>
                                        <input
                                            type="number"
                                            min="0"
                                            t-model.number="state.multiPayments.card"
                                        />
                                    </div>

                                    <div class="multi-pay-row">
                                        <span>🏦 Bank Amount</span>
                                        <input
                                            type="number"
                                            min="0"
                                            t-model.number="state.multiPayments.bank"
                                        />
                                    </div>

                                </div>

                            </t>


                            <div class="change-display">
                                <span>Change to Return</span>
                                <strong class="change-amount">Rs. <t t-esc="change"/></strong>
                            </div>

                        </div>


                        <!-- ACTIONS -->

                        <div class="cart-actions">

                            <button
                                class="clear-button"
                                t-on-click="clearCart"
                            >
                                Clear
                            </button>

                            <button
                                class="complete-button"
                                t-att-disabled="!canCompleteSale"
                                t-on-click="completeSale"
                            >
                                <t t-if="state.processing">
                                    ⏳ Processing...
                                </t>

                                <t t-else="">
                                    Confirm Sale · Rs. <t t-esc="total"/>
                                </t>
                            </button>

                        </div>

                    </section>

                </main>

            </t>

        </div>

    </t>

</templates>