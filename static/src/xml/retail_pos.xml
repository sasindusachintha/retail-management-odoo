<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

    <t t-name="shop_management.RetailPOS">

        <div class="retail-pos">

            <!-- HEADER -->

            <header class="retail-header">

                <div>
                    <h1>Retail POS</h1>
                    <span>Shop Management</span>
                </div>

                <div class="search-area">

                    <input
                        type="text"
                        placeholder="Search products..."
                        t-model="state.search"
                    />

                </div>

            </header>


            <!-- COMPLETED SALE -->

            <t t-if="state.completedOrder">

                <div class="sale-success">

                    <div class="success-icon">✓</div>

                    <h1>Sale Completed</h1>

                    <h2>
                        <t t-esc="state.completedOrder.name"/>
                    </h2>

                    <div class="receipt">

                        <div class="receipt-title">
                            SHOP RECEIPT
                        </div>

                        <div class="receipt-line">
                            <span>Order</span>
                            <strong>
                                <t t-esc="state.completedOrder.name"/>
                            </strong>
                        </div>

                        <div class="receipt-line">
                            <span>Subtotal</span>
                            <strong>
                                Rs.
                                <t t-esc="state.completedOrder.subtotal"/>
                            </strong>
                        </div>

                        <div class="receipt-line">
                            <span>Discount</span>
                            <strong>
                                Rs.
                                <t t-esc="state.completedOrder.discount"/>
                            </strong>
                        </div>

                        <div class="receipt-total">
                            <span>TOTAL</span>
                            <strong>
                                Rs.
                                <t t-esc="state.completedOrder.amount_total"/>
                            </strong>
                        </div>

                        <div class="receipt-line">
                            <span>Paid</span>
                            <strong>
                                Rs.
                                <t t-esc="state.completedOrder.amount_paid"/>
                            </strong>
                        </div>

                        <div class="receipt-line">
                            <span>Change</span>
                            <strong>
                                Rs.
                                <t t-esc="state.completedOrder.change_amount"/>
                            </strong>
                        </div>

                        <div class="receipt-line">
                            <span>Payment</span>
                            <strong>
                                <t t-esc="state.completedOrder.payment_method"/>
                            </strong>
                        </div>

                    </div>

                    <div class="success-actions">

                        <button
                            class="print-button"
                            t-on-click="printReceipt"
                        >
                            Print Receipt
                        </button>

                        <button
                            class="new-sale-button"
                            t-on-click="newSale"
                        >
                            New Sale
                        </button>

                    </div>

                </div>

            </t>


            <!-- POS -->

            <t t-else="">

                <main class="retail-main">

                    <!-- PRODUCTS -->

                    <section class="products-section">

                        <div class="section-title">

                            <h2>Products</h2>

                            <span>
                                <t t-esc="filteredProducts.length"/>
                                products
                            </span>

                        </div>


                        <!-- CATEGORY FILTER -->

                        <div class="categories">

                            <button
                                t-att-class="state.category === 'all' ? 'category active' : 'category'"
                                t-on-click="() => state.category = 'all'"
                            >
                                All
                            </button>

                            <t
                                t-foreach="categories"
                                t-as="category"
                                t-key="category"
                            >

                                <button
                                    t-att-class="state.category === category ? 'category active' : 'category'"
                                    t-on-click="() => state.category = category"
                                >
                                    <t t-esc="category"/>
                                </button>

                            </t>

                        </div>


                        <!-- PRODUCT GRID -->

                        <div class="product-grid">

                            <t
                                t-foreach="filteredProducts"
                                t-as="product"
                                t-key="product.id"
                            >

                                <button
                                    t-att-class="product.quantity > 0 ? 'product-card' : 'product-card out-of-stock'"
                                    t-on-click="() => this.addProduct(product)"
                                >

                                    <div class="product-name">
                                        <t t-esc="product.name"/>
                                    </div>

                                    <div class="product-category">
                                        <t t-esc="product.category || 'General'"/>
                                    </div>

                                    <div class="product-price">
                                        Rs.
                                        <t t-esc="product.price"/>
                                    </div>

                                    <div class="product-stock">

                                        <t t-if="product.quantity > 0">
                                            Stock:
                                            <t t-esc="product.quantity"/>
                                        </t>

                                        <t t-else="">
                                            OUT OF STOCK
                                        </t>

                                    </div>

                                </button>

                            </t>

                        </div>

                    </section>


                    <!-- CART -->

                    <section class="cart-section">

                        <div class="section-title">

                            <h2>Current Sale</h2>

                            <span>
                                <t t-esc="state.cart.length"/>
                                items
                            </span>

                        </div>


                        <!-- CUSTOMER -->

                        <div class="field">

                            <label>Customer</label>

                            <select t-model="state.customer_id">

                                <option value="">
                                    Walk-in Customer
                                </option>

                                <t
                                    t-foreach="state.customers"
                                    t-as="customer"
                                    t-key="customer.id"
                                >

                                    <option
                                        t-att-value="customer.id"
                                    >
                                        <t t-esc="customer.name"/>
                                        <t t-if="customer.phone">
                                            -
                                            <t t-esc="customer.phone"/>
                                        </t>
                                    </option>

                                </t>

                            </select>

                        </div>


                        <!-- CART ITEMS -->

                        <div class="cart-items">

                            <t t-if="!state.cart.length">

                                <div class="empty-cart">

                                    <div class="empty-icon">
                                        🛒
                                    </div>

                                    <strong>
                                        Cart is empty
                                    </strong>

                                    <span>
                                        Select products to start a sale
                                    </span>

                                </div>

                            </t>


                            <t
                                t-foreach="state.cart"
                                t-as="item"
                                t-key="item.product_id"
                            >

                                <div class="cart-item">

                                    <div class="cart-item-info">

                                        <strong>
                                            <t t-esc="item.name"/>
                                        </strong>

                                        <span>
                                            Rs.
                                            <t t-esc="item.price"/>
                                        </span>

                                    </div>


                                    <div class="quantity-controls">

                                        <button
                                            t-on-click="() => this.decrease(item)"
                                        >
                                            −
                                        </button>

                                        <strong>
                                            <t t-esc="item.quantity"/>
                                        </strong>

                                        <button
                                            t-on-click="() => this.increase(item)"
                                        >
                                            +
                                        </button>

                                    </div>


                                    <strong class="line-total">

                                        Rs.
                                        <t t-esc="item.price * item.quantity"/>

                                    </strong>


                                    <button
                                        class="remove-button"
                                        t-on-click="() => this.removeItem(item)"
                                    >
                                        ×
                                    </button>

                                </div>

                            </t>

                        </div>


                        <!-- DISCOUNT -->

                        <div class="discount-field">

                            <label>Discount (Rs.)</label>

                            <input
                                type="number"
                                min="0"
                                t-model.number="state.discount"
                            />

                        </div>


                        <!-- TOTALS -->

                        <div class="cart-summary">

                            <div>
                                <span>Subtotal</span>

                                <strong>
                                    Rs.
                                    <t t-esc="subtotal"/>
                                </strong>
                            </div>

                            <div>
                                <span>Discount</span>

                                <strong class="discount-value">
                                    - Rs.
                                    <t t-esc="discount"/>
                                </strong>
                            </div>

                            <div class="total-row">

                                <span>Total</span>

                                <strong>
                                    Rs.
                                    <t t-esc="total"/>
                                </strong>

                            </div>

                        </div>


                        <!-- PAYMENT -->

                        <div class="payment-section">

                            <h3>Payment</h3>

                            <div class="payment-methods">

                                <button
                                    t-att-class="state.payment_method === 'cash' ? 'payment-method active' : 'payment-method'"
                                    t-on-click="() => state.payment_method = 'cash'"
                                >
                                    Cash
                                </button>

                                <button
                                    t-att-class="state.payment_method === 'card' ? 'payment-method active' : 'payment-method'"
                                    t-on-click="() => state.payment_method = 'card'"
                                >
                                    Card
                                </button>

                                <button
                                    t-att-class="state.payment_method === 'bank' ? 'payment-method active' : 'payment-method'"
                                    t-on-click="() => state.payment_method = 'bank'"
                                >
                                    Bank
                                </button>

                            </div>


                            <label>Amount Received</label>

                            <input
                                class="amount-input"
                                type="number"
                                min="0"
                                t-model.number="state.amount_paid"
                                placeholder="0.00"
                            />

                            <div class="change-display">

                                <span>Change</span>

                                <strong>
                                    Rs.
                                    <t t-esc="change"/>
                                </strong>

                            </div>

                        </div>


                        <!-- ACTIONS -->

                        <div class="cart-actions">

                            <button
                                class="clear-button"
                                t-on-click="clearCart"
                            >
                                Clear
                            </button>

                            <button
                                class="complete-button"
                                t-att-disabled="!canCompleteSale"
                                t-on-click="completeSale"
                            >

                                <t t-if="state.processing">
                                    Processing...
                                </t>

                                <t t-else="">
                                    Complete Sale
                                    · Rs.
                                    <t t-esc="total"/>
                                </t>

                            </button>

                        </div>

                    </section>

                </main>

            </t>

        </div>

    </t>

</templates>