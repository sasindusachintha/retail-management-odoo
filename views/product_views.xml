<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- ============================================================
         PRODUCT CATEGORY
    ============================================================ -->

    <record id="view_shop_product_category_list" model="ir.ui.view">
        <field name="name">shop.product.category.list</field>
        <field name="model">shop.product.category</field>
        <field name="arch" type="xml">
            <list string="Product Categories">
                <field name="name"/>
                <field name="product_count" string="Products"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_shop_product_category_form" model="ir.ui.view">
        <field name="name">shop.product.category.form</field>
        <field name="model">shop.product.category</field>
        <field name="arch" type="xml">
            <form string="Product Category">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Category Name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="active"/>
                        <field name="product_count" string="Products in Category" readonly="1"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_shop_product_categories" model="ir.actions.act_window">
        <field name="name">Product Categories</field>
        <field name="res_model">shop.product.category</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- ============================================================
         PRODUCT LIST
    ============================================================ -->

    <record id="view_shop_product_list" model="ir.ui.view">
        <field name="name">shop.product.list</field>
        <field name="model">shop.product</field>
        <field name="arch" type="xml">
            <list string="Products">
                <field name="name"/>
                <field name="sku" string="SKU"/>
                <field name="barcode"/>
                <field name="category_id" string="Category"/>
                <field name="supplier_id" string="Supplier"/>
                <field name="price" string="Selling Price"/>
                <field name="cost_price" string="Purchase Cost"/>
                <field name="quantity" string="Stock"/>
                <field name="min_stock" string="Min Stock"/>
                <field name="stock_status"
                       decoration-danger="stock_status == 'out'"
                       decoration-warning="stock_status == 'low'"
                       decoration-success="stock_status == 'ok'"
                       widget="badge"
                />
                <field name="active" string="Active"/>
            </list>
        </field>
    </record>


    <!-- ============================================================
         PRODUCT FORM
    ============================================================ -->

    <record id="view_shop_product_form" model="ir.ui.view">
        <field name="name">shop.product.form</field>
        <field name="model">shop.product</field>
        <field name="arch" type="xml">
            <form string="Product">
                <sheet>
                    <field name="has_cost_increase" invisible="1"/>

                    <!-- Cost Increase Alert Banner -->
                    <div class="alert alert-danger" role="alert" invisible="not has_cost_increase" style="font-weight:bold; margin-bottom:16px;">
                        <field name="cost_increase_alert" readonly="1"/>
                    </div>

                    <!-- Image + title -->
                    <div class="oe_title" style="display:flex; gap:16px; align-items:flex-start;">
                        <field name="image"
                               widget="image"
                               class="oe_avatar"
                               options="{'size': [90, 90]}"
                        />
                        <div style="flex:1;">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="Product Name"/>
                            </h1>
                            <field name="stock_status"
                                   widget="badge"
                                   decoration-danger="stock_status == 'out'"
                                   decoration-warning="stock_status == 'low'"
                                   decoration-success="stock_status == 'ok'"
                            />
                        </div>
                    </div>

                    <group>

                        <!-- Identification -->
                        <group string="Identification">
                            <field name="sku" string="SKU / Product Code"/>
                            <field name="barcode" string="Barcode"/>
                            <field name="category_id" string="Category"/>
                            <field name="supplier_id" string="Primary Supplier"/>
                            <field name="active" string="Active"/>
                        </group>

                        <!-- Pricing & Purchasing Intelligence -->
                        <group string="Pricing &amp; Cost Intelligence">
                            <field name="price" string="Selling Price"/>
                            <field name="cost_price" string="Current Cost Price"/>
                            <field name="latest_purchase_cost" string="Latest Purchase Cost"/>
                            <field name="previous_purchase_cost" string="Previous Purchase Cost"/>
                        </group>

                    </group>

                    <!-- Supplier Recommendations & Savings -->
                    <group string="Supplier Purchasing Intelligence">
                        <group>
                            <field name="cheapest_supplier_id" string="Recommended Supplier"/>
                            <field name="best_purchase_cost" string="Lowest Recent Cost"/>
                        </group>
                        <group>
                            <field name="potential_savings" string="Potential Savings/Unit"/>
                            <field name="cost_increase_threshold" string="Alert Threshold (%)"/>
                        </group>
                    </group>

                    <!-- Stock -->
                    <group string="Stock">
                        <group>
                            <field name="quantity" string="Current Stock"/>
                            <field name="min_stock" string="Minimum Stock"/>
                        </group>
                        <group>
                            <field name="stock_status"
                                   string="Stock Status"
                                   widget="badge"
                                   decoration-danger="stock_status == 'out'"
                                   decoration-warning="stock_status == 'low'"
                                   decoration-success="stock_status == 'ok'"
                            />
                        </group>
                    </group>

                    <notebook>
                        <page string="Purchase Price History &amp; Timeline">
                            <field name="purchase_line_ids" readonly="1">
                                <list create="0" delete="0" edit="0" default_order="purchase_date desc">
                                    <field name="purchase_date" string="Date"/>
                                    <field name="purchase_id" string="Purchase Ref"/>
                                    <field name="supplier_id"/>
                                    <field name="quantity"/>
                                    <field name="cost_price" string="Unit Cost"/>
                                    <field name="subtotal"/>
                                    <field name="purchase_state" widget="badge"/>
                                </list>
                            </field>
                        </page>

                        <page string="Supplier Cost Comparison">
                            <field name="supplier_comparison_ids" readonly="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="supplier_id"/>
                                    <field name="latest_cost"/>
                                    <field name="previous_cost"/>
                                    <field name="total_quantity" string="Qty Purchased"/>
                                    <field name="total_spent" sum="Total Spent"/>
                                    <field name="is_cheapest" string="Lowest Cost Supplier"/>
                                </list>
                            </field>
                        </page>

                        <page string="Description">
                            <field name="description" nolabel="1"/>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>


    <!-- ============================================================
         PRODUCT SEARCH VIEW
    ============================================================ -->

    <record id="view_shop_product_search" model="ir.ui.view">
        <field name="name">shop.product.search</field>
        <field name="model">shop.product</field>
        <field name="arch" type="xml">
            <search string="Search Products">

                <!-- Quick search fields -->
                <field name="name" string="Product Name"/>
                <field name="sku" string="SKU"/>
                <field name="barcode" string="Barcode"/>
                <field name="category_id" string="Category"/>
                <field name="supplier_id" string="Supplier"/>

                <!-- Filters -->
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Inactive" domain="[('active', '=', False)]"/>

                <separator/>

                <filter name="low_stock" string="Low Stock"
                        domain="[('stock_status', '=', 'low')]"/>
                <filter name="out_of_stock" string="Out of Stock"
                        domain="[('stock_status', '=', 'out')]"/>
                <filter name="in_stock" string="In Stock"
                        domain="[('stock_status', '=', 'ok')]"/>

                <!-- Group By -->
                <group>
                    <filter name="group_category" string="Category"
                            context="{'group_by': 'category_id'}"/>
                    <filter name="group_supplier" string="Supplier"
                            context="{'group_by': 'supplier_id'}"/>
                    <filter name="group_status" string="Stock Status"
                            context="{'group_by': 'stock_status'}"/>
                </group>

            </search>
        </field>
    </record>


    <!-- ============================================================
         WINDOW ACTIONS
    ============================================================ -->

    <record id="action_shop_product" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">shop.product</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_shop_product_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>


    <!-- Cost Increase Alerts View & Action -->
    <record id="view_shop_product_cost_alerts_list" model="ir.ui.view">
        <field name="name">shop.product.cost.alerts.list</field>
        <field name="model">shop.product</field>
        <field name="arch" type="xml">
            <list string="Cost Increase Alerts" create="false">
                <field name="name"/>
                <field name="supplier_id" string="Primary Supplier"/>
                <field name="previous_purchase_cost" string="Previous Cost"/>
                <field name="latest_purchase_cost" string="Latest Cost"/>
                <field name="price_change_amount" string="Increase Amount"/>
                <field name="price_change_percent" string="Increase %" decoration-danger="price_change_percent &gt;= 10.0" decoration-warning="price_change_percent &lt; 10.0"/>
                <field name="cost_increase_alert" string="Warning Details"/>
            </list>
        </field>
    </record>

    <record id="action_shop_cost_increase_alerts" model="ir.actions.act_window">
        <field name="name">Cost Increase Alerts</field>
        <field name="res_model">shop.product</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_shop_product_cost_alerts_list"/>
        <field name="domain">[('has_cost_increase', '=', True)]</field>
    </record>



    <!-- ============================================================
         MENUS
    ============================================================ -->

    <menuitem
        id="menu_shop_products"
        name="Products"
        parent="menu_shop_management"
        action="action_shop_product"
        sequence="10"
        groups="shop_management.group_shop_manager,shop_management.group_shop_inventory,shop_management.group_shop_cashier"
    />

    <menuitem
        id="menu_shop_product_categories"
        name="Categories"
        parent="menu_shop_management"
        action="action_shop_product_categories"
        sequence="11"
        groups="shop_management.group_shop_manager,shop_management.group_shop_inventory"
    />

</odoo>
