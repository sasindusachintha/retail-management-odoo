<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Reorder Assistant Form View -->
    <record id="view_shop_reorder_assistant_form" model="ir.ui.view">
        <field name="name">shop.reorder.assistant.form</field>
        <field name="model">shop.reorder.assistant</field>
        <field name="arch" type="xml">
            <form string="Reorder Assistant">
                <header>
                    <button name="action_generate_suggestions"
                            string="Refresh Suggestions"
                            type="object"
                            class="btn-secondary"/>
                    <button name="action_create_purchase_orders"
                            string="Create Purchase Orders"
                            type="object"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Reorder Assistant</h1>
                    </div>

                    <div class="alert alert-info" role="alert" style="margin-bottom:16px;">
                        <strong>Purchasing Intelligence Guidance:</strong> Reorder Assistant calculates suggested quantities using low-stock thresholds (stock &lt;= min stock) combined with historical purchase averages. Review and modify suggested quantities or suppliers as needed, then click <strong>Create Purchase Orders</strong> to group items by supplier and generate draft purchase orders.
                    </div>

                    <group>
                        <group>
                            <field name="filter_type"/>
                        </group>
                        <group>
                            <field name="total_suggested_count" string="Suggested Products"/>
                            <field name="selected_count" string="Selected for Reorder"/>
                            <field name="total_estimated_cost" widget="monetary" string="Estimated Cost"/>
                        </group>
                    </group>

                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="selected"/>
                            <field name="product_id" readonly="1"/>
                            <field name="supplier_id"/>
                            <field name="current_stock"/>
                            <field name="min_stock"/>
                            <field name="avg_purchase_qty"/>
                            <field name="suggested_qty"/>
                            <field name="unit_cost"/>
                            <field name="estimated_subtotal" sum="Total Cost"/>
                            <field name="calculation_note"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Reorder Assistant Window Action -->
    <record id="action_shop_reorder_assistant" model="ir.actions.act_window">
        <field name="name">Reorder Assistant</field>
        <field name="res_model">shop.reorder.assistant</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

</odoo>
